{
  "name": "heat-comparability-console",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "node scripts/generate-samples.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run samples && npm run test && npm run build"
  },
  "license": "ISC",
  "description": "城市供热投诉与室温监测数据可比性分析工具",
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
